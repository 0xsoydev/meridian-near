{
  "name": "web",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --env-file-if-exists=.env --test lib/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "stub:rail": "node --experimental-strip-types scripts/stub-rail.ts",
    "seed": "node --experimental-strip-types --env-file-if-exists=.env scripts/seed.ts",
    "e2e": "node --experimental-strip-types --env-file-if-exists=.env scripts/e2e.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@neondatabase/serverless": "1.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "near-api-js": "7.4.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
